  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "                      INSTRUCTIONS\nMOVEMENT\r\nPress A / D or Left /
    Right Arrow to move between lanes\n\r\nPASSENGERS\r\nCollect passengers on the
    sides of the road to earn money\r\nEach passenger adds a fare to your wallet\n\r\nDROP-OFF\r\nWhen
    the drop-off countdown appears, move to the road boundary\r\nPress E to drop
    off passengers\r\nDrop off with 0\u20133 seconds left for a R10 tip\r\nDrop off
    with 4\u20135 seconds left for a R5 tip\n\r\nOBSTACLES\r\nAvoid cars \u2014 hit
    one and you must pay a penalty to continue\r\nAvoid potholes \u2014 each one
    removes a wheel\r\nLose all wheels and you can buy one back for R50 (once per
    run)\n\r\nPOLICE\r\nStay on the boundary too long and the police will arrive\r\nCrashing
    during a police visit or continuing to loiter on the boundary line results in
    a fine and that's the end of your run\n\r\nPOWER-UPS\r\nShield \u2014 protects
    you from one collision\r\nBinoculars \u2014 press Q to zoom out and see further
    ahead\n\r\nPAUSE\r\nPress P to pause the game\n\r\nSurvive as long as possible
    and earn as much money as you can!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0161d805a3764c089bef00bfe00793f5, type: 2}
